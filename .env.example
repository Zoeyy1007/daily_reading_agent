POSTGRES_PASSWORD=replace_me
DATABASE_URL=postgresql+psycopg://daily_reading:replace_me@127.0.0.1:5432/daily_reading
LOG_LEVEL=INFO
RSS_POLL_MINUTES=30
HTTP_TIMEOUT_SECONDS=20
ARTICLE_MIN_WORDS=150
USER_AGENT=DailyReadingAgent/0.1 (personal local project)
JINA_API_KEY=
INGESTION_MAX_CONCURRENCY=4
SCHEDULER_ENABLED=false
DAILY_LIST_HOUR=8
SCHEDULER_TIMEZONE=America/Los_Angeles
DEFAULT_USER_ID=1
AUTH_COOKIE_NAME=daily_reading_session
# Keep false for local http://127.0.0.1; use true behind production HTTPS.
AUTH_COOKIE_SECURE=false
AUTH_SESSION_DAYS=30

# Phase 2 filtering, scoring, and daily-list settings
MIN_ARTICLE_WORDS=200
MAX_ARTICLE_WORDS=4000
MAX_ARTICLE_AGE_HOURS=48
ALLOWED_LANGUAGES=en
ALLOWED_CONTENT_TYPES=news,analysis,opinion,tutorial,other
PREFERRED_TOPICS=
PREFERRED_SOURCE_IDS=
BLOCKED_SOURCE_IDS=
DAILY_ARTICLE_TARGET=5
EXPECTED_READING_MINUTES_PER_ARTICLE=6
DAILY_READING_MINUTES=30
READING_WORDS_PER_MINUTE=225
PERSONALIZATION_WEIGHT=30

# Phase 4 agent workflow
AGENT_MAX_EXPANSION_ROUNDS=3
AGENT_RECURSION_LIMIT=40
AGENT_RUN_IN_BACKGROUND=true
LANGGRAPH_STRICT_MSGPACK=true

# Phase 5 model roles. Keep real keys only in .env, never in this file.
PHASE_FIVE_ENABLED=true
PHASE_FIVE_MAX_ARTICLES=30
LLM_MAX_CONCURRENCY=3
EMBEDDING_MAX_CONCURRENCY=2

EMBEDDING_PROVIDER=qwen
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=10
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://YOUR-QWEN-OPENAI-COMPATIBLE-ENDPOINT/v1

CLASSIFICATION_PROVIDER=deepseek
CLASSIFICATION_MODEL=deepseek-v4-flash
CLASSIFICATION_THINKING=false
CLASSIFICATION_MAX_OUTPUT_TOKENS=1500
CLAIM_EXTRACTION_PROVIDER=deepseek
CLAIM_EXTRACTION_MODEL=deepseek-v4-pro
CLAIM_EXTRACTION_THINKING=false
CLAIM_EXTRACTION_MAX_OUTPUT_TOKENS=8000
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

EVIDENCE_COMPARISON_PROVIDER=deepseek
EVIDENCE_COMPARISON_MODEL=deepseek-v4-pro
EVIDENCE_COMPARISON_THINKING=false
EVIDENCE_COMPARISON_MAX_OUTPUT_TOKENS=4000
# Optional alternative evidence provider
MOONSHOT_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1

ARTICLE_CHUNK_WORD_THRESHOLD=1500
ARTICLE_CHUNK_TARGET_WORDS=800
ARTICLE_CHUNK_OVERLAP_WORDS=100
EVIDENCE_RETRIEVAL_CHUNK_LIMIT=20
EVIDENCE_BM25_WEIGHT=0.4
EVIDENCE_VECTOR_WEIGHT=0.6
EVIDENCE_MAX_CLAIM_PAIRS=20
EVIDENCE_PAIR_BATCH_SIZE=5
STORY_CLUSTER_SIMILARITY_THRESHOLD=0.82
STORY_CLUSTER_REDUNDANCY_THRESHOLD=0.94
STORY_CLUSTER_MAX_ARTICLES=5
STORY_CLUSTER_LOOKBACK_DAYS=7
UNSELECTED_CHUNK_RETENTION_DAYS=7
UNSELECTED_EVIDENCE_RETENTION_DAYS=7
SELECTED_EVIDENCE_RETENTION_DAYS=30

# Phase 6 source-grounded supplements. External search remains unavailable until
# an application search-provider adapter and its key are configured.
PHASE_SIX_ENABLED=true
SUPPLEMENT_MODEL=deepseek-v4-pro
SUPPLEMENT_THINKING=false
SUPPLEMENT_MAX_OUTPUT_TOKENS=4000
SUPPLEMENT_MAX_ITERATIONS=4
SUPPLEMENT_MAX_CONCURRENCY=2
SUPPLEMENT_VERIFICATION_MAX_ATTEMPTS=3
SUPPLEMENT_WORD_RATIO=0.5
SUPPLEMENT_RETENTION_DAYS=30
SUPPLEMENT_TOOL_POLICY_PATH=config/supplement_tools.yaml
TAVILY_API_KEY=
# `none` omits Tavily's search_depth parameter; Tavily then uses its default.
TAVILY_SEARCH_DEPTH=none
TAVILY_BASE_URL=https://api.tavily.com
ANALYTICS_ENABLED=true
ANALYTICS_ADMIN_LOGIN_IDS=18
ANALYTICS_RETENTION_DAYS=365
